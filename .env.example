# Gemini API Key (Vite environment variable)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini Model (Default: gemini-2.5-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash

# Fallback Gemini Models (Comma-separated fallback order)
VITE_GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.5-pro

